# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://leadgen:leadgen@localhost:5432/leadgen"

# NextAuth
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (used for both app login and Gmail mailbox connection scopes).
# Register BOTH redirect URIs on this OAuth client:
#   {AUTH_URL}/api/auth/callback/google
#   {AUTH_URL}/api/mailbox/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 32-byte (base64) key used to encrypt mailbox OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Optional. Enables real Lighthouse audits (performance/accessibility/
# best-practices/SEO) during website inspection, via Google's free PageSpeed
# Insights API. Without it, the existing heuristic checks still run on
# their own. Get a key at https://console.cloud.google.com/apis/credentials
# after enabling the "PageSpeed Insights API" on a Google Cloud project.
PAGESPEED_API_KEY=""
